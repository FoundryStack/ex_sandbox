# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Temporary files, for example, from tests.
/tmp/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
ex_sandbox-*.tar

# The Python that made these is gone -- `priv/egress/nsacceptor.py` was an
# imported module, and it is what wrote a `__pycache__` into `priv/`, which
# `mix.exs`'s `files:` then globbed into a release tarball. The probes under
# `docker/` are run as scripts and cache nothing, so these match nothing today.
# They stay because the cost of the next imported module is a shipped .pyc.
__pycache__/
*.pyc

# Isolation-harness output. `compose.isolation.yml` bind-mounts this directory so
# the census and suite log survive the container; every file in it is one run's
# artefact, and the runner clears them at start.
docker/results/

# Built by Mix.Tasks.Compile.NetnsNif from c_src/. Architecture-specific.
/priv/netns_nif.so
