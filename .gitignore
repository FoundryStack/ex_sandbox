# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Temporary files, for example, from tests.
/tmp/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
ex_sandbox-*.tar

# CPython writes these beside priv/egress/nsacceptor.py on first import.
__pycache__/
*.pyc

# Isolation-harness output. `compose.isolation.yml` bind-mounts this directory so
# the census and suite log survive the container; every file in it is one run's
# artefact, and the runner clears them at start.
docker/results/

# Built by Mix.Tasks.Compile.NetnsNif from c_src/. Architecture-specific.
/priv/netns_nif.so
