#!/bin/sh
# The forced command of a gateway account's key:
#   restrict,command="/usr/local/libexec/ex-sandbox-launcher [SLICE_DIR [SYSTEMD_RUN [SOCKET [SOCAT]]]]" ssh-ed25519 ...
#
# Verbs, read from SSH_ORIGINAL_COMMAND:
#   ping                 answers "pong"
#   sample               the sandbox slice's memory.current and memory.max
#   sample ID            sandbox ID's scope peak since the last sample, in
#                        bytes, resetting memory.peak; memory.current where
#                        the kernel has no resettable memory.peak
#   conform              the Mechanism.Beam capability groups this host
#                        fails, one per line, probed as ExSandbox.Capability
#                        probes them; no output when it can confine
#   launch ARGV64 ARG..  execs the base64, newline-joined argv when it has
#                        ExSandbox.Hardening.Linux's shape; the trailing ARGs
#                        are the ones :peer appends for the sandbox's BEAM
#   connect              relays stdin and stdout to the gateway's socket,
#                        SOCKET or $XDG_RUNTIME_DIR/ex-sandbox/gateway.sock
set -eu
set -f

slice_dir=${1:-}
systemd_run=${2:-/usr/bin/systemd-run}
gateway_socket=${3:-${XDG_RUNTIME_DIR:-/nonexistent}/ex-sandbox/gateway.sock}
socat=${4:-socat}

refuse() {
  printf 'ex-sandbox-launcher: refused: %s\n' "$1" >&2
  exit 64
}

slice() {
  dir=$slice_dir
  if [ -z "$dir" ]; then
    for candidate in /sys/fs/cgroup/user.slice/user-*.slice/user@*.service/axonn-sandbox.slice; do
      dir=$candidate
      break
    done
  fi
  [ -r "$dir/memory.current" ] || refuse "no sandbox slice at $dir"
}

sample() {
  slice
  if [ "$#" -eq 0 ]; then
    printf '%s %s\n' "$(cat "$dir/memory.current")" "$(cat "$dir/memory.max")"
    return
  fi
  case "$1" in
    "" | *[!A-Za-z0-9-]*) refuse "sandbox id $1" ;;
  esac
  scope="$dir/sandbox-$1.scope"
  [ -r "$scope/memory.current" ] || refuse "no scope for sandbox $1"
  if peak=$(cat "$scope/memory.peak" 2>/dev/null) && (printf '0' >"$scope/memory.peak") 2>/dev/null; then
    printf '%s\n' "$peak"
  else
    cat "$scope/memory.current"
  fi
}

quiet() {
  "$@" >/dev/null 2>&1
}

conform() {
  quiet "$systemd_run" --user --scope --quiet -p MemoryMax=64M true ||
    quiet "$systemd_run" --scope --quiet -p MemoryMax=64M true ||
    echo resource_limits
  quiet bwrap --unshare-user --ro-bind / / true || echo filesystem_confinement
  quiet setpriv --reuid=65534 --regid=65534 --clear-groups true || echo privilege_separation
  { quiet bwrap --unshare-user --unshare-net --ro-bind / / true && quiet command -v pasta; } ||
    echo network_restriction
}

# The argv must be: systemd-run with only the scope options Hardening.Linux
# passes, then setpriv dropping to a non-root uid and gid with no new
# privileges, then (in order) bwrap with --unshare-pid and --die-with-parent,
# and env -i. Everything after setpriv runs as the dropped uid, so the rest
# of bwrap's options can reach only what that uid could reach anyway.
check_shape() {
  [ "$#" -gt 0 ] || refuse "empty argv"
  case "$1" in
    */systemd-run | systemd-run) shift ;;
    *) refuse "argv does not start with systemd-run" ;;
  esac

  scope=no
  memory=no
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --scope) scope=yes ;;
      --user | --quiet) ;;
      --unit=sandbox-*.scope) ;;
      -p)
        [ "$#" -gt 1 ] || refuse "-p without a property"
        case "$2" in
          MemoryMax=*M) memory=yes ;;
          CPUQuota=*% | MemorySwapMax=0) ;;
          *) refuse "systemd-run property $2" ;;
        esac
        shift
        ;;
      setpriv) break ;;
      *) refuse "systemd-run option $1" ;;
    esac
    shift
  done
  [ "$scope" = yes ] || refuse "no --scope"
  [ "$memory" = yes ] || refuse "no MemoryMax"
  [ "$#" -gt 0 ] || refuse "no setpriv"
  shift

  reuid=no
  regid=no
  clear=no
  nnp=no
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --reuid=0 | --regid=0) refuse "setpriv to root" ;;
      --reuid=*[!0-9]* | --regid=*[!0-9]*) refuse "setpriv id $1" ;;
      --reuid=?*) reuid=yes ;;
      --regid=?*) regid=yes ;;
      --clear-groups) clear=yes ;;
      --no-new-privs) nnp=yes ;;
      -*) refuse "setpriv option $1" ;;
      *) break ;;
    esac
    shift
  done
  [ "$reuid$regid$clear$nnp" = yesyesyesyes ] || refuse "setpriv does not drop every privilege"

  want="bwrap --unshare-pid --die-with-parent env -i"
  for arg in "$@"; do
    next=${want%% *}
    [ -n "$want" ] && [ "$arg" = "$next" ] || continue
    case "$want" in
      *" "*) want=${want#* } ;;
      *) want="" ;;
    esac
  done
  [ -z "$want" ] || refuse "missing ${want%% *} in the confinement"
}

launch() {
  [ "$#" -gt 0 ] || refuse "launch without an argv"
  payload=$1
  shift
  for arg in "$@"; do
    case "$arg" in
      *[!A-Za-z0-9_./:=@,+-]*) refuse "peer argument $arg" ;;
    esac
  done
  decoded=$(printf '%s' "$payload" | base64 -d 2>/dev/null) || refuse "argv is not base64"
  old_ifs=$IFS
  IFS='
'
  # shellcheck disable=SC2086
  set -- $decoded "$@"
  IFS=$old_ifs
  check_shape "$@"
  shift
  exec "$systemd_run" "$@"
}

connect() {
  [ "$#" -eq 0 ] || refuse "connect takes no arguments"
  [ -S "$gateway_socket" ] || refuse "no gateway socket at $gateway_socket"
  exec "$socat" STDIO "UNIX-CONNECT:$gateway_socket"
}

# shellcheck disable=SC2086
set -- ${SSH_ORIGINAL_COMMAND:-}
[ "$#" -gt 0 ] || refuse "no verb"
verb=$1
shift

case "$verb" in
  ping) echo pong ;;
  sample) sample "$@" ;;
  conform) conform ;;
  launch) launch "$@" ;;
  connect) connect "$@" ;;
  *) refuse "unknown verb $verb" ;;
esac
